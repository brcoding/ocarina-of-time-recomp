+        // The f32 result to f16 as the emulated HMMA rounds it (ocarina-of-time-recomp): beyond half precision it becomes
+        // +-65504, not +-infinity (Ryujinx's half packing, which the emulation's HFMA2 ends in, rounds toward zero on AMD
+        // and so saturates); NaN stays NaN (the comparisons are false for it). Without this an HMMA result that overflows
+        // became infinity, and a later layer's infinity minus infinity NaN: the TAAU upscaler's top-left corner on the
+        // level, in about a third of the presents (docs/phase3.md 2026-11-09).
+        private static SpvInstruction HalfFromSingle(CodeGenContext context, SpvInstruction v2)
+        {
+            SpvInstruction f32 = context.TypeFP32(), v2f32 = context.TypeVector(f32, 2), v2bool = context.TypeVector(context.TypeBool(), 2);
+            SpvInstruction hi = context.ConstantComposite(v2f32, context.Constant(f32, 65504f), context.Constant(f32, 65504f));
+            SpvInstruction lo = context.ConstantComposite(v2f32, context.Constant(f32, -65504f), context.Constant(f32, -65504f));
+            SpvInstruction x = context.Select(v2f32, context.FOrdGreaterThan(v2bool, v2, hi), hi, v2);
+            x = context.Select(v2f32, context.FOrdLessThan(v2bool, x, lo), lo, x);
+
+            return context.FConvert(context.TypeVector(context.TypeFloat(16), 2), x);
         }
 
